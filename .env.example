# mock is the safe default. Set foundry for the project Responses API or azure
# for the Azure OpenAI-compatible endpoint.
AI_PROVIDER=mock

# Microsoft Foundry project mode (recommended).
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_NAME=foundry-optimization-agent
FOUNDRY_USE_AGENT=true

# Logical model-to-deployment mapping. Claude falls back to gpt-5-mini in the
# default deployment because marketplace models require separate availability
# and terms acceptance.
MODEL_DEPLOYMENT_GPT_5_NANO=gpt-5-nano
MODEL_DEPLOYMENT_GPT_5_MINI=gpt-5-mini
MODEL_DEPLOYMENT_GPT_4_1_MINI=gpt-4-1-mini
MODEL_DEPLOYMENT_CLAUDE_OPUS_5=gpt-5-mini
MODEL_ROUTER_DEPLOYMENT_NAME=

# Azure OpenAI-compatible endpoint mode. Entra ID is used when the key is blank.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Optional local client telemetry export. azd configures this on App Service.
APPLICATIONINSIGHTS_CONNECTION_STRING=
