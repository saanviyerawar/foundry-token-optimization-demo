{
  "name": "foundry-agent-optimization-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "azure:deploy": "pwsh -NoProfile -File scripts/deploy.ps1",
    "azure:agent": "tsx scripts/create-agent.ts",
    "azure:role": "pwsh -NoProfile -File scripts/assign-presenter-role.ps1",
    "azure:router": "pwsh -NoProfile -File scripts/deploy-model-router.ps1",
    "azure:portal-assets": "pwsh -NoProfile -File scripts/setup-portal-demo.ps1",
    "azure:portal-assets:apply": "tsx scripts/setup-portal-demo.ts",
    "azure:validate": "tsx scripts/validate-azure-config.ts",
    "azure:down": "pwsh -NoProfile -File scripts/teardown.ps1"
  },
  "dependencies": {
    "@azure/ai-projects": "^2.6.0",
    "@azure/identity": "^4.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
